# Copy to .env on the VPS (never commit real secrets)
# cp .env.example .env && nano .env

NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_or_publishable_key
NEXT_PUBLIC_ADMIN_EMAILS=admin@example.com
NEXT_PUBLIC_SITE_URL=https://redlake.in

# Optional — not required by Next.js runtime
# DATABASE_URL=postgresql://postgres:PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres
